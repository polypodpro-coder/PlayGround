{
  "manifest_version": 3,
  "name": "Local Browser Agent",
  "version": "0.1.0",
  "description": "Goal-driven browser agent powered entirely by a local LLM (Ollama). No cloud, no API credits.",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Local Browser Agent"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
