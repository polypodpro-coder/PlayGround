# Reference only. Inject real values from your hosting secret manager.
# Never commit an actual .env file and never use VITE_* for these values.
NODE_ENV=development
APP_BASE_URL=http://localhost:8787
HOST=127.0.0.1
PORT=8787
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32 cryptographically random bytes encoded as 64 hexadecimal characters.
SESSION_SECRET=
DATABASE_URL=
# TLS verification is on by default; false is allowed only for local development.
DATABASE_TLS=true
DATABASE_CA=
# Specific trusted reverse-proxy subnet(s), comma-separated; leave empty locally.
TRUSTED_PROXY=
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
# Private buyer STL imports and selected-farm sharing; requires creations.sql.
# Buyer generation and billing stay on Meshy's website. No Meshy API key required.
CREATION_SHARING_ENABLED=false
# Required in addition to complete configuration for live payments.
# Set only after documented staging, operations, tax, legal and security sign-off.
LAUNCH_APPROVAL_REFERENCE=

